# Copy to the ignored eos.toml. This process config selects the local live
# binding. The binding example contains only one host speaker; extend it to
# describe the deployed robot before starting EOS.

[gateway]
host = "127.0.0.1"
grpc_port = 16200

[workflow]
journal_enabled = true

[log]
level = "off"
file_level = "info"
jsonl_level = "trace"

[mode]
[[mode.binding]]
backend = "../ext/live/binding.toml"
profile = "live"

[mode.primitives]
expose_operator = false
