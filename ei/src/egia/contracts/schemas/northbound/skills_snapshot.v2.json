{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "egia.contracts.northbound.skills_snapshot.v2",
  "$defs": {
    "SkillDescriptor": {
      "additionalProperties": false,
      "description": "One deployment-admitted EOS skill descriptor.",
      "properties": {
        "backend": {
          "title": "Backend",
          "type": "string"
        },
        "eos_robot_id": {
          "title": "Eos Robot Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "primitives": {
          "items": {
            "type": "string"
          },
          "title": "Primitives",
          "type": "array"
        },
        "primitive_refs": {
          "items": {
            "$ref": "#/$defs/SkillPrimitiveReference"
          },
          "title": "Primitive Refs",
          "type": "array"
        },
        "parameters_schema": {
          "additionalProperties": true,
          "title": "Parameters Schema",
          "type": "object"
        },
        "returns_schema": {
          "additionalProperties": true,
          "title": "Returns Schema",
          "type": "object"
        },
        "resources": {
          "items": {
            "$ref": "#/$defs/SkillResource"
          },
          "title": "Resources",
          "type": "array"
        }
      },
      "required": [
        "backend",
        "eos_robot_id",
        "name",
        "version",
        "description"
      ],
      "title": "SkillDescriptor",
      "type": "object"
    },
    "SkillPrimitiveReference": {
      "additionalProperties": false,
      "description": "One exact primitive identity declared by a native EOS skill.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "SkillPrimitiveReference",
      "type": "object"
    },
    "SkillResource": {
      "additionalProperties": false,
      "description": "One resource template advertised as planning input for a skill.",
      "properties": {
        "uri_template": {
          "title": "Uri Template",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "uri_template",
        "description"
      ],
      "title": "SkillResource",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Version-two skill catalog with explicit service availability.",
  "properties": {
    "schema_version": {
      "const": 2,
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "available": {
      "default": false,
      "title": "Available",
      "type": "boolean"
    },
    "skills": {
      "items": {
        "$ref": "#/$defs/SkillDescriptor"
      },
      "title": "Skills",
      "type": "array"
    },
    "unavailable_backends": {
      "items": {
        "type": "string"
      },
      "title": "Unavailable Backends",
      "type": "array"
    },
    "count": {
      "default": 0,
      "title": "Count",
      "type": "integer"
    }
  },
  "title": "SkillsSnapshot",
  "type": "object"
}
