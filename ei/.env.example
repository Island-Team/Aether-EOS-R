# EGIA environment — copy to .env and adjust.

# EGIA component configuration root (default: <prefix>/etc/egia)
#EGIA_ETC=<prefix>/etc/egia

# Launch mode (default: from etc/egia/modes.toml, currently "sandbox")
#EGIA_MODE=sandbox

# Model binding from etc/egia/models.toml (glm is selected in etc/egia/egia.toml)
#EGIA_MODEL=glm

# Generic API key for a deployment binding that uses EGIA_MODEL_API_KEY.
#EGIA_MODEL_API_KEY=

# Shipped cloud bindings use provider-specific variables.
#SANLANG_BIGMODEL_API_KEY=
#ALIYUN_MAAS_API_KEY=
#MOONSHOT_API_KEY=
#OPENAI_API_KEY=

#EGIA_ASR_API_KEY=
#EGIA_TTS_API_KEY=

# Development SSH tunnels used by scripts/ssh-tunnel.sh. Names are expanded to
# SSH_TUNNEL_<NAME> and SSH_TUNNEL_<NAME>_PASSWORD_ENV variables.
#SSH_TUNNELS="lab"
#SSH_TUNNEL_LAB="developer@robot.example.com:22 50051 8000"
#SSH_TUNNEL_LAB_PASSWORD_ENV=LAB_SSH_PASSWORD
#LAB_SSH_PASSWORD=
