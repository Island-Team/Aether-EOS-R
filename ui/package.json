{
  "name": "isosui",
  "version": "0.2.1",
  "private": true,
  "description": "Public IsOS configuration editor",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "webpack serve --mode development --env target=local",
    "start": "webpack serve --mode production --env target=local",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:local": "webpack --mode production --env target=local && node scripts/write-manifest.mjs local",
    "build:hosted": "webpack --mode production --env target=hosted && node scripts/write-manifest.mjs hosted",
    "build": "npm run typecheck && npm run build:local && npm run build:hosted && node scripts/verify-bundles.mjs"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@fontsource/noto-serif-sc": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reactflow": "^11.11.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "css-loader": "^7.1.2",
    "html-webpack-plugin": "^5.6.3",
    "jsdom": "^24.1.3",
    "sass": "^1.80.6",
    "sass-loader": "^16.0.3",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.1",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^5.6.3",
    "vitest": "^1.6.1",
    "webpack": "^5.96.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.1.0"
  }
}
