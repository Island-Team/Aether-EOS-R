{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "egia.contracts.perception.world.vad.v1",
  "title": "VadSnapshot",
  "description": "Compact voice activity for one processed microphone window; excludes audio and utterance data.",
  "type": "object",
  "properties": {
    "type": {"const": "vad.snapshot"},
    "schema_version": {"const": "1.0"},
    "sequence": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "timestamp": {"type": "string", "format": "date-time", "minLength": 20, "maxLength": 35},
    "source_sequence": {
      "description": "Completed VAD result sequence; advances once for each successful model result.",
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "source_timestamp_ns": {
      "description": "Optional microphone stamp in nanoseconds, kept in its original clock domain.",
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "speech": {"type": "boolean"},
    "probability": {"type": "number", "minimum": 0, "maximum": 1}
  },
  "required": [
    "type",
    "schema_version",
    "sequence",
    "timestamp",
    "source_sequence",
    "speech",
    "probability"
  ],
  "additionalProperties": false
}
