{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "egia.contracts.perception.model.chat_completion_request.v1",
  "title": "ChatCompletionRequest",
  "description": "Bounded non-streaming text chat request.",
  "type": "object",
  "properties": {
    "messages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "role": {"type": "string", "enum": ["system", "user", "assistant"]},
          "content": {"type": "string", "minLength": 1, "maxLength": 4096}
        },
        "required": ["role", "content"],
        "additionalProperties": false
      }
    },
    "temperature": {"type": "number", "minimum": 0.0, "maximum": 2.0},
    "max_tokens": {"type": "integer", "minimum": 1, "maximum": 256},
    "stream": {"type": "boolean", "const": false, "default": false}
  },
  "required": ["messages"],
  "additionalProperties": false
}
