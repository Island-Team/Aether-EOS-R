{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "egia.contracts.perception.model.asr_request.v1",
  "$defs": {
    "AudioInput": {
      "type": "object",
      "properties": {
        "data_b64": {"type": "string", "minLength": 4, "contentEncoding": "base64"},
        "filename": {"type": "string", "minLength": 1},
        "media_type": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.+-]*/[A-Za-z0-9][A-Za-z0-9.+-]*$"}
      },
      "required": ["data_b64"],
      "additionalProperties": false
    }
  },
  "title": "AsrRequest",
  "description": "Provider-neutral audio transcription request.",
  "type": "object",
  "properties": {
    "input": {"$ref": "#/$defs/AudioInput"},
    "language": {"type": "string", "minLength": 1},
    "prompt": {"type": "string"},
    "temperature": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "stream": {"type": "boolean", "default": false}
  },
  "required": ["input"],
  "additionalProperties": false
}
