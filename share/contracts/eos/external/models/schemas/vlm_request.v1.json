{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eos.contracts.perception.model.vlm_request.v1",
  "title": "VlmRequest",
  "description": "Non-streaming language request with an optional JPEG camera frame.",
  "type": "object",
  "properties": {
    "messages": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "role": {"type": "string", "enum": ["system", "user", "assistant"]},
          "content": {"type": "string", "minLength": 1, "maxLength": 4096}
        },
        "required": ["role", "content"],
        "additionalProperties": false
      }
    },
    "input": {
      "type": "object",
      "properties": {
        "data_b64": {"type": "string", "minLength": 4, "contentEncoding": "base64"},
        "media_type": {"type": "string", "const": "image/jpeg"}
      },
      "required": ["data_b64", "media_type"],
      "additionalProperties": false
    },
    "temperature": {"type": "number", "minimum": 0.0, "maximum": 2.0},
    "max_tokens": {"type": "integer", "minimum": 1, "maximum": 128000},
    "reasoning": {"type": "boolean", "default": false},
    "stream": {"type": "boolean", "const": false, "default": false}
  },
  "required": ["messages"],
  "additionalProperties": false
}
