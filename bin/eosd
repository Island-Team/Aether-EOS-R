#!/usr/bin/env bash
# Public EOS launcher for source checkouts and installed Island prefixes.
set -euo pipefail

LAUNCHER="$(readlink -f "${BASH_SOURCE[0]}")"
DEFAULT_PREFIX="$(cd "$(dirname "$LAUNCHER")/.." && pwd)"
PREFIX="${ISLAND_PREFIX:-$DEFAULT_PREFIX}"
case "$PREFIX" in
  /*) ;;
  *) echo "eosd: ISLAND_PREFIX must be absolute: $PREFIX" >&2; exit 2 ;;
esac

if [[ -d "$PREFIX/src/eos" ]]; then
  MODE="source"
  : "${ISLAND_ETC:=$PREFIX/etc}"
  : "${ISLAND_SHARE:=$PREFIX/share}"
  : "${ISLAND_LIBEXEC:=$PREFIX/libexec}"
  : "${ISLAND_STATE:=$PREFIX/var/lib}"
  : "${ISLAND_CACHE:=$PREFIX/var/cache}"
  : "${ISLAND_LOG:=$PREFIX/var/log}"
  : "${ISLAND_RUN:=$PREFIX/var/run}"
  : "${ISLAND_TMP:=$PREFIX/var/tmp}"
  if [[ -n "${ISLAND_BUILD_DIR:-}" ]]; then
    case "$ISLAND_BUILD_DIR" in
      /*) BUILD_DIR="$ISLAND_BUILD_DIR" ;;
      *) echo "eosd: ISLAND_BUILD_DIR must be absolute: $ISLAND_BUILD_DIR" >&2; exit 2 ;;
    esac
  else
    BUILD_DIR="$("$PREFIX/eos-build.sh" --print-build-dir)"
  fi
  if [[ -z "${EOS_SKILLS:-}" && -d "$BUILD_DIR/skills" ]]; then
    EOS_SKILLS="$BUILD_DIR/skills"
  fi
  PROGRAM="$BUILD_DIR/src/eos/bin/eosd"
elif [[ -d "$PREFIX/share/contracts" && -d "$PREFIX/libexec" ]]; then
  MODE="portable"
  : "${ISLAND_ETC:=$PREFIX/etc}"
  : "${ISLAND_SHARE:=$PREFIX/share}"
  : "${ISLAND_LIBEXEC:=$PREFIX/libexec}"
  : "${ISLAND_STATE:=$PREFIX/var/lib}"
  : "${ISLAND_CACHE:=$PREFIX/var/cache}"
  : "${ISLAND_LOG:=$PREFIX/var/log}"
  : "${ISLAND_RUN:=$PREFIX/var/run}"
  : "${ISLAND_TMP:=$PREFIX/var/tmp}"
  PROGRAM="$ISLAND_LIBEXEC/eosd"
else
  MODE="system"
  : "${ISLAND_ETC:=/etc/island}"
  : "${ISLAND_SHARE:=$PREFIX/share/island}"
  : "${ISLAND_LIBEXEC:=$PREFIX/libexec/island}"
  : "${ISLAND_STATE:=/var/lib/island}"
  : "${ISLAND_CACHE:=/var/cache/island}"
  : "${ISLAND_LOG:=/var/log/island}"
  : "${ISLAND_RUN:=/run/island}"
  : "${ISLAND_TMP:=/var/tmp/island}"
  PROGRAM="$ISLAND_LIBEXEC/eosd"
fi

if [[ -z "${EOS_SKILLS:-}" ]]; then
  for skills_dir in "$PREFIX/lib/island/skills" "$PREFIX/lib64/island/skills"; do
    if [[ -d "$skills_dir" ]]; then
      EOS_SKILLS="$skills_dir"
      break
    fi
  done
fi

export ISLAND_PREFIX="$PREFIX" ISLAND_MODE="${ISLAND_MODE:-$MODE}"
export ISLAND_ETC ISLAND_SHARE ISLAND_LIBEXEC ISLAND_STATE ISLAND_CACHE
export ISLAND_LOG ISLAND_RUN ISLAND_TMP
EOS_ETC="${EOS_ETC:-$ISLAND_ETC/eos}"
EOS_CONTRACTS="${EOS_CONTRACTS:-$ISLAND_SHARE}"
export EOS_ETC EOS_CONTRACTS EOS_SKILLS

if [[ ! -x "$PROGRAM" ]]; then
  echo "eosd: native executable not found: $PROGRAM" >&2
  if [[ "$MODE" == "source" ]]; then
    echo "eosd: build it with: cmake -S '$PREFIX' -B '$BUILD_DIR' && cmake --build '$BUILD_DIR'" >&2
  fi
  exit 2
fi
exec "$PROGRAM" --etc "$EOS_ETC" --contracts "$EOS_CONTRACTS" "$@"
