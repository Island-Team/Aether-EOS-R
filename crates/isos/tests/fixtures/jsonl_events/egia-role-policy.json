{
  "schema": "egia-jsonl-role-policy-a03-v2",
  "source": "egia",
  "core": "egia",
  "codes": {
    "egia_admission_decided": {
      "fields": {
        "outcome": "admission_outcome",
        "operation_id": "opaque_id",
        "mission_id?": "opaque_id"
      },
      "level_by_outcome": {
        "admitted": "info",
        "rejected": "warn"
      },
      "message": "Primitive admission decided",
      "node_path": "null_or_admitted_egia"
    },
    "egia_discovery_lost": {
      "fields": {
        "reason_code": "discovery_reason"
      },
      "level": "warn",
      "message": "EOS discovery unavailable",
      "node_path": "null"
    },
    "egia_discovery_restored": {
      "fields": {
        "generation": "positive_integer"
      },
      "level": "info",
      "message": "EOS discovery restored",
      "node_path": "null"
    },
    "egia_events_suppressed": {
      "fields": {
        "suppressed_count": "positive_integer"
      },
      "level": "warn",
      "message": "Repeated EGIA diagnostics suppressed",
      "node_path": "null"
    },
    "egia_mission_started": {
      "fields": {
        "mission_id": "opaque_id"
      },
      "level": "info",
      "message": "Mission started",
      "node_path": "null_or_admitted_egia"
    },
    "egia_mission_restored": {
      "fields": {
        "mission_id": "opaque_id",
        "outcome": "restore_outcome"
      },
      "level_by_outcome": {
        "pending": "warn",
        "failed_closed": "error"
      },
      "message": "Mission checkpoint restored",
      "node_path": "null_or_admitted_egia"
    },
    "egia_monitor_episode": {
      "fields": {
        "outcome": "monitor_outcome"
      },
      "level_by_outcome": {
        "fault": "warn",
        "recovered": "info",
        "stop_required": "error"
      },
      "message": "Monitor episode changed",
      "node_path": "null_or_admitted_egia"
    },
    "egia_mission_terminal": {
      "fields": {
        "mission_id": "opaque_id",
        "outcome": "mission_outcome"
      },
      "level_by_outcome": {
        "cancelled": "info",
        "failed": "error",
        "succeeded": "info",
        "suspended": "warn",
        "unknown": "error"
      },
      "message": "Mission settled",
      "node_path": "null_or_admitted_egia"
    },
    "egia_operation_submitted": {
      "fields": {
        "mission_id?": "opaque_id",
        "operation_id": "opaque_id"
      },
      "level": "info",
      "message": "Operation submitted to EOS",
      "node_path": "null_or_admitted_egia"
    },
    "egia_operation_terminal": {
      "fields": {
        "operation_id": "opaque_id",
        "outcome": "operation_outcome"
      },
      "level_by_outcome": {
        "cancelled": "info",
        "failed": "error",
        "rejected": "warn",
        "succeeded": "info"
      },
      "message": "EOS operation settled",
      "node_path": "null_or_admitted_egia"
    },
    "egia_operation_unknown": {
      "fields": {
        "operation_id": "opaque_id",
        "reason_code": "unknown_reason"
      },
      "level": "error",
      "message": "EOS operation outcome unknown",
      "node_path": "null_or_admitted_egia"
    },
    "egia_proposal_created": {
      "fields": {
        "operation_id": "opaque_id",
        "mission_id?": "opaque_id"
      },
      "level": "info",
      "message": "Primitive proposal created",
      "node_path": "null_or_admitted_egia"
    },
    "egia_ready": {
      "fields": {
        "generation": "positive_integer"
      },
      "level": "info",
      "message": "EGIA ready",
      "node_path": "null"
    },
    "egia_recovery_required": {
      "fields": {
        "mission_id?": "opaque_id",
        "reason_code": "recovery_reason"
      },
      "level": "error",
      "message": "Operator reconciliation required",
      "node_path": "null_or_admitted_egia"
    },
    "egia_safety_latched": {
      "fields": {
        "reason_code": "latch_reason"
      },
      "level": "error",
      "message": "Safety latch engaged",
      "node_path": "null_or_admitted_egia"
    },
    "egia_safety_rejected": {
      "fields": {
        "mission_id?": "opaque_id",
        "operation_id?": "opaque_id",
        "reason_code": "safety_reason"
      },
      "level": "warn",
      "message": "Safety gate rejected request",
      "node_path": "null_or_admitted_egia"
    },
    "egia_safety_reset_requested": {
      "fields": {},
      "level": "warn",
      "message": "Local safety reset check requested",
      "node_path": "null"
    },
    "egia_safety_reset_completed": {
      "fields": {},
      "level": "info",
      "message": "Safety latch reset completed",
      "node_path": "null"
    },
    "egia_safety_reset_refused": {
      "fields": {
        "reason_code": "reset_reason"
      },
      "level": "error",
      "message": "Safety latch reset refused",
      "node_path": "null"
    },
    "egia_stage_transition": {
      "fields": {
        "kind": "stage_kind"
      },
      "level": "info",
      "message": "Typed stage value accepted",
      "node_path": "null_or_admitted_egia"
    },
    "egia_start_failed": {
      "fields": {
        "reason_code": "start_reason"
      },
      "level": "error",
      "message": "EGIA startup failed",
      "node_path": "null"
    },
    "egia_starting": {
      "fields": {},
      "level": "info",
      "message": "EGIA starting",
      "node_path": "null"
    },
    "egia_stopped": {
      "fields": {
        "state": "stopped_state"
      },
      "level_by_state": {
        "stop_unconfirmed": "error",
        "stopped": "info"
      },
      "message": "EGIA stopped",
      "node_path": "null"
    },
    "egia_stopping": {
      "fields": {},
      "level": "info",
      "message": "EGIA stopping",
      "node_path": "null"
    }
  },
  "types": {
    "admission_outcome": [
      "admitted",
      "rejected"
    ],
    "discovery_reason": [
      "eos_unavailable",
      "stale_generation",
      "watch_lost"
    ],
    "latch_reason": [
      "audit_fault",
      "operator_estop",
      "eos_unknown"
    ],
    "mission_outcome": [
      "succeeded",
      "failed",
      "cancelled",
      "suspended",
      "unknown"
    ],
    "monitor_outcome": [
      "fault",
      "recovered",
      "stop_required"
    ],
    "opaque_id": {
      "json": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "operation_outcome": [
      "succeeded",
      "failed",
      "cancelled",
      "rejected"
    ],
    "positive_integer": {
      "json": "integer",
      "max": 4294967295,
      "min": 1
    },
    "recovery_reason": [
      "unknown_outcome",
      "checkpoint_incomplete",
      "rediscovery_required"
    ],
    "reset_reason": [
      "alias_coverage",
      "eos_unsafe",
      "revision_mismatch",
      "lookup_unresolved",
      "state_invalid"
    ],
    "restore_outcome": [
      "pending",
      "failed_closed"
    ],
    "stage_kind": [
      "endpoint",
      "admission",
      "stop",
      "discovery",
      "resource",
      "result",
      "health",
      "hearing",
      "observations",
      "body",
      "memory",
      "snapshot",
      "intent",
      "selected",
      "lifecycle",
      "proposal",
      "plan_state",
      "registry",
      "latch",
      "rejection",
      "progress",
      "bounds",
      "status"
    ],
    "safety_reason": [
      "estop_latched",
      "policy_denied",
      "capability_missing",
      "stale_generation",
      "invalid_request"
    ],
    "start_reason": [
      "config_invalid",
      "eos_unavailable",
      "listener_unavailable",
      "model_unavailable",
      "internal"
    ],
    "stopped_state": [
      "stopped",
      "stop_unconfirmed"
    ],
    "unknown_reason": [
      "timeout",
      "disconnect",
      "receipt_missing"
    ]
  }
}
