{
  "contract": "isos-log-cursors-p07-v1",
  "endpoint": "/api/isos/v1/logs",
  "view": "current",
  "response_keys": ["scope","anchor","lines","next_cursor","rotated","diagnostics"],
  "scope_keys": ["kind","run_id","active_revision"],
  "anchor_keys": ["kind","state","event"],
  "filter_order": ["scope","anchor","run_id","source","level","node_path","correlation_id"],
  "diagnostic_order": ["log_run_changed","log_cursor_expired","log_collector_gap","log_anchor_unavailable"],
  "bounds": {"default_limit":100,"max_limit":200,"max_scan_bytes":65536,"max_cursor_ascii_bytes":512},
  "cases": [
    {"name":"manager_package_failure_filter_bypass","phase":"before_first_run","query":{"source":"eos","level":"error"},"expected":{"scope_kind":"manager_session","anchor_kind":"first_prelaunch_failure","anchor_state":"found","anchor_code":"package_load_failed","anchor_source":"packages","lines":[],"diagnostics":[]}},
    {"name":"manager_apply_failure","phase":"before_first_run","query":{"source":"all"},"expected":{"scope_kind":"manager_session","anchor_kind":"first_prelaunch_failure","anchor_state":"found","anchor_code":"deployment_preflight_failed","lines":[],"diagnostics":[]}},
    {"name":"manager_validate_only_not_anchor","phase":"before_first_run","query":{"source":"all"},"expected":{"scope_kind":"manager_session","anchor_kind":"first_prelaunch_failure","anchor_state":"pending","anchor_code":null,"lines":[],"diagnostics":[]}},
    {"name":"run_pending_empty","phase":"admitted_no_eligible_event","query":{"source":"all"},"expected":{"scope_kind":"deployment_run","anchor_kind":"first_ready_or_failure","anchor_state":"pending","anchor_code":null,"lines":[],"diagnostics":[]}},
    {"name":"run_ready_first","phase":"running","query":{"source":"all"},"expected":{"scope_kind":"deployment_run","anchor_kind":"first_ready_or_failure","anchor_state":"found","anchor_code":"eos_ready","lines":["deployment_ready"],"diagnostics":[]}},
    {"name":"run_failure_before_ready","phase":"running","query":{"source":"all"},"expected":{"scope_kind":"deployment_run","anchor_kind":"first_ready_or_failure","anchor_state":"found","anchor_code":"eos_start_failed","lines":[],"diagnostics":[]}},
    {"name":"run_filtered_anchor_and_progress","phase":"running","query":{"source":"egia","level":"warn","node_path":"/cores/egia/layers/agent/groups/runtime/nodes/a","correlation_id":"c4"},"expected":{"scope_kind":"deployment_run","anchor_kind":"first_ready_or_failure","anchor_state":"found","anchor_code":"eos_ready","lines":[],"cursor_advances_over_filtered_records":true,"diagnostics":[]}},
    {"name":"rotation_retained","phase":"running","query":{"source":"all","cursor":"lc1.RETAINED"},"expected":{"scope_kind":"deployment_run","anchor_state":"found","rotated":true,"lines":["deployment_ready"],"diagnostics":[]}},
    {"name":"rotation_expired","phase":"running","query":{"source":"all","cursor":"lc1.EXPIRED"},"expected":{"scope_kind":"deployment_run","anchor_state":"found","rotated":true,"lines":["deployment_ready"],"diagnostics":[{"code":"log_cursor_expired","count":null}]}},
    {"name":"new_admitted_run_rebase","phase":"new_run","query":{"source":"all","cursor":"lc1.OLD_RUN"},"expected":{"scope_kind":"deployment_run","anchor_state":"pending","lines":[],"diagnostics":[{"code":"log_run_changed","count":null}]}},
    {"name":"stop_retains_last_run","phase":"stopped_pid_absent","query":{"source":"all"},"expected":{"scope_kind":"deployment_run","anchor_state":"found","lines":["deployment_stopped"],"process_status_run_id":"r7","diagnostics":[]}},
    {"name":"failed_retains_last_run","phase":"failed_active_revision_null","query":{"source":"all"},"expected":{"scope_kind":"deployment_run","anchor_state":"found","lines":["deployment_failed"],"process_status_run_id":"r7","diagnostics":[]}},
    {"name":"collector_outage_recovery","phase":"recovered","query":{"source":"all"},"expected":{"scope_kind":"deployment_run","anchor_state":"found","diagnostics":[{"code":"log_collector_gap","count":null}]}},
    {"name":"anchor_write_failure","phase":"anchor_unavailable","query":{"source":"all"},"expected":{"scope_kind":"deployment_run","anchor_state":"unavailable","anchor_code":null,"diagnostics":[{"code":"log_anchor_unavailable","count":null}]}},
    {"name":"legacy_socket_cannot_anchor","phase":"legacy_socket_only","query":{"source":"all"},"expected":{"scope_kind":"deployment_run","anchor_state":"pending","anchor_code":null,"lines":[],"diagnostics":[]}},
    {"name":"cursor_filter_mismatch","phase":"running","query":{"source":"egia","cursor":"lc1.ALL_FILTER"},"expected_error":{"http":400,"path":"/query/cursor","code":"log_cursor_filter_mismatch"}},
    {"name":"cursor_tampered","phase":"running","query":{"source":"all","cursor":"lc1.TAMPERED"},"expected_error":{"http":400,"path":"/query/cursor","code":"log_cursor_invalid"}},
    {"name":"cursor_key_rotated","phase":"running","query":{"source":"all","cursor":"lc1.OLD_KEY"},"expected_error":{"http":400,"path":"/query/cursor","code":"log_cursor_invalid"}},
    {"name":"legacy_cursor_rejected","phase":"running","query":{"source":"all","cursor":"123:456:789"},"expected_error":{"http":400,"path":"/query/cursor","code":"log_cursor_invalid"}},
    {"name":"node_path_invalid","phase":"running","query":{"node_path":"/cores/eos/layers/control/groups/manual/nodes/a/inputs/x"},"expected_error":{"http":400,"path":"/query/node_path","code":"log_node_path_invalid"}},
    {"name":"correlation_id_invalid","phase":"running","query":{"correlation_id":"with space"},"expected_error":{"http":400,"path":"/query/correlation_id","code":"log_correlation_id_invalid"}},
    {"name":"scope_unrecoverable","phase":"invalid_cursor_state","query":{"source":"all"},"expected_error":{"http":503,"path":"/scope","code":"log_scope_unavailable"}}
  ]
}
