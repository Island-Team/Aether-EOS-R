#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [[ -f "$ROOT/.env" ]]; then
  set -a
  # shellcheck disable=SC1091
  source "$ROOT/.env"
  set +a
fi
set -a
# shellcheck disable=SC1091
source "$ROOT/.env.example"
set +a
if [[ -x "$ROOT/../../target/release/isos" ]]; then
  exec "$ROOT/../../target/release/isos" "$@"
fi
if [[ -x "$ROOT/target/release/isos" ]]; then
  exec "$ROOT/target/release/isos" "$@"
fi
if command -v cargo >/dev/null 2>&1; then
  CARGO_BIN="$(command -v cargo)"
elif [[ -x "${HOME:-}/.cargo/bin/cargo" ]]; then
  CARGO_BIN="${HOME}/.cargo/bin/cargo"
else
  echo "IsOS requires Rust Cargo; install Rust from https://rustup.rs or add ~/.cargo/bin to PATH" >&2
  exit 127
fi
exec "$CARGO_BIN" run --quiet --release --manifest-path "$ROOT/Cargo.toml" -- "$@"
