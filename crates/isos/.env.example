# Source-launcher defaults. bin/isos and isos.sh set ROOT before sourcing this file.
# A local .env is sourced first; existing values are preserved here.
# The installed binary reads TOML directly.
ISOS_AETHER_BIN_DIR=${ISOS_AETHER_BIN_DIR:-${ROOT}/../../target/release}
ISOS_EGIA_BIN_DIR=${ISOS_EGIA_BIN_DIR:-${ROOT}/../../ei/bin}
ISOS_EGIA_DEFAULTS_DIR=${ISOS_EGIA_DEFAULTS_DIR:-${ROOT}/../../ei/etc/egia}
ISOS_EGIA_FACTORY_DEFAULTS_DIR=${ISOS_EGIA_FACTORY_DEFAULTS_DIR:-${ROOT}/../../ei/share/defaults/egia}
ISOSUI_DIST_DIR=${ISOSUI_DIST_DIR:-${ROOT}/../../ui/dist/local}
EOS_REPO_PATH=${EOS_REPO_PATH:-${ROOT}/../..}
EGIA_REPO_PATH=${EGIA_REPO_PATH:-${ROOT}/../../ei}
# Optional source checkout for UI development.
ISOSUI_REPO_PATH=${ISOSUI_REPO_PATH:-${ROOT}/../../ui}
# Optional source-run overrides. Remove # before a line to enable it.
# ISOS_HTTP_PORT=16000
# ISOSUI_PORT=16001
